{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@libs/*": ["../../../libs/*"],
      "@contracts": ["../../../libs/contracts/src/intervention-status"]
    }
  },
  "include": ["src/**/*.ts"]
}
