{
  "name": "il-arrive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm -F api dev",
    "dev:web": "pnpm -F web dev",
    "dev:track": "pnpm -F track dev",
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./libs/*\" build",
    "lint": "eslint \"**/{src,test,libs}/**/*.ts\" && pnpm lint:ui-colors",
    "lint:ui-colors": "node -e \"const fs=require('fs');const files=fs.readdirSync('libs/ui/src/components',{recursive:true}).filter(f=>f.endsWith('.ts')&&!f.includes('spec')).map(f=>'libs/ui/src/components/'+f);const rx=/#[0-9a-fA-F]{3,6}\\b/;let found=0;files.forEach(f=>{const c=fs.readFileSync(f,'utf8');const m=c.match(rx);if(m)found++});process.exit(found>0?1:0)\"",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./libs/*\" typecheck",
    "test": "pnpm -r --filter \"./apps/api\" test && pnpm -r --filter \"./libs/ui\" test",
    "test:integration": "pnpm -r --filter \"./apps/api\" test:integration",
    "db:migrate": "pnpm -F api db:migrate",
    "db:seed": "pnpm -F api db:seed",
    "db:studio": "pnpm -F api db:studio",
    "db:generate": "pnpm -F api db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.2"
  }
}
