{
  "name": "il-arrive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm -F api dev",
    "dev:web": "pnpm -F web dev",
    "dev:track": "pnpm -F track dev",
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./libs/*\" build",
    "lint": "eslint \"**/{src,test,libs}/**/*.ts\"",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./libs/*\" typecheck",
    "test": "pnpm -r --filter \"./apps/api\" test && pnpm -r --filter \"./libs/ui\" test",
    "test:integration": "pnpm -r --filter \"./apps/api\" test:integration",
    "db:migrate": "pnpm -F api db:migrate",
    "db:seed": "pnpm -F api db:seed",
    "db:studio": "pnpm -F api db:studio",
    "db:generate": "pnpm -F api db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.2"
  }
}
