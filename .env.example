# Il Arrive — development environment
# Copy this file to .env and fill in the values

# PostgreSQL
DATABASE_URL=postgresql://ilarrive:ilarrive_dev@localhost:5432/ilarrive?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=noreply@ilarrive.local

# App
APP_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
FRONTEND_WEB_URL=http://localhost:4200
FRONTEND_TRACK_URL=http://localhost:4201

# JWT
JWT_SECRET=change-me-in-production

# Session cookie
SESSION_SECRET=change-me-in-production

# Sentry (optional — no-op if not set)
SENTRY_DSN=

# SMS Provider (dev = console)
SMS_PROVIDER=console
BREVO_API_KEY=
BREVO_SENDER=

# Routing (dev = fake)
ROUTING_PROVIDER=fake
TOMTOM_API_KEY=

# Geocoding (dev = BAN)
GEOCODING_PROVIDER=ban

# Map tiles (public key — safe in frontend)
MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/tiles/256/{z}/{x}/{y}.png
MAP_TILES_KEY=
