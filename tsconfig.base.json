{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@il-arrive/ui": ["libs/ui/src/public-api.ts"],
      "@il-arrive/ui/*": ["libs/ui/src/*"],
      "@il-arrive/contracts": ["libs/contracts/src/index.ts"],
      "@il-arrive/contracts/*": ["libs/contracts/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
